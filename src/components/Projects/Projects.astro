---
import ProjectCard from "./ProjectCard/ProjectCard.astro";
import type { Locale } from "@src/i18n/translations";
import { getI18n } from "@src/i18n/utils";
import "./Projects.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = getI18n(locale);

const baseProjects = [
  {
    image: "projects/img/aerolab.webp",
    video: "projects/video/aerolab.mp4",
    github: "https://github.com/ibarzabal-jm/aerolab-frontend-dev-coding-challenge",
    demo: "https://juanma-aerolab-challenge.netlify.app",
    technologies: ["Nextjs", "React", "Css", "Typescript", "React Testing Library", "Jest", "Figma"],
  },
  {
    image: "projects/img/buscamina.webp",
    video: "projects/video/buscamina.mp4",
    github: "https://github.com/ibarzabal-jm/React-Minesweeper",
    demo: "https://juanma-minesweeper.netlify.app/",
    technologies: ["React", "Css", "Typescript"],
  },
  {
    image: "/projects/img/neongiphy.webp",
    video: "/projects/video/neongiphy.mp4",
    github: "https://github.com/ibarzabal-jm/Giphy-Next-App",
    technologies: ["Next.js", "Typescript", "Sass", "Giphy API"],
  },
  {
    image: "/projects/img/pokedex.webp",
    video: "/projects/video/pokedex.mp4",
    github: "https://github.com/ibarzabal-jm/React-Pokedex-DevOff-Desafio-5",
    demo: "https://juanma-pokedex.netlify.app/",
    technologies: ["React.js", "Chakra-UI", "JavaScript", "Pokeapi", "React-Router"],
  },
];

const projects = baseProjects.map((project, index) => ({
  ...project,
  title: t.projects.list[index].title,
  description: t.projects.list[index].description,
}));
---

<div class="projects-container">
  {projects.map((project) => <ProjectCard {...project} locale={locale} />)}
</div>
