---
import { Icon } from "astro-icon/components";
import type { Locale } from "@src/i18n/translations";
import { getI18n } from "@src/i18n/utils";
import "./ProjectCard.css";

interface Props {
  title: string;
  description: string;
  image: string;
  video: string;
  github: string;
  demo?: string;
  technologies: string[];
  locale: Locale;
}

const { title, description, image, video, github, demo, technologies, locale } = Astro.props as Props;
const { t } = getI18n(locale);
---

<article class="project-card">
  <div class="project-video-container">
    <video autoplay muted loop playsinline preload="none" poster={image}>
      <source src={video} type="video/mp4" />
      <track kind="captions" src="" srclang="es" label={t.accessibility.captionsSpanish} />
    </video>
  </div>
  <h3>{title}</h3>
  <p class="project-description">{description}</p>

  <ul class="technology-list">
    {technologies.map((tech: string) => <li>{tech}</li>)}
  </ul>

  <div class="project-links">
    <a href={github} target="_blank" rel="noopener noreferrer" class="project-link github-link">
      <Icon name="mdi:github" /> GitHub
    </a>
    {
      demo && (
        <a
          href={demo}
          target="_blank"
          rel="noopener noreferrer"
          class="project-link demo-link"
          aria-label={`${t.projects.demoAriaLabel} ${title}`}
        >
          <Icon name="mdi:open-in-new" /> {t.projects.viewProject}
        </a>
      )
    }
  </div>
</article>
