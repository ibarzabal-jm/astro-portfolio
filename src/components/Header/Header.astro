---
import ToggleTheme from "./ToggleTheme/ToggleTheme.astro";
import DownloadCV from "./DownloadCV/DownloadCV.astro";
import Hamburger from "./Hamburger/Hamburger.astro";
import Sidebar from "./Sidebar/Sidebar.astro";
import LanguageSwitcher from "./LanguageSwitcher/LanguageSwitcher.astro";
import type { Locale } from "@src/i18n/translations";
import { localizeHref } from "@src/i18n/utils";
import "./Header.css";

interface Props {
  locale: Locale;
  labels: {
    home: string;
    experiences: string;
    projects: string;
    contact: string;
    downloadCv: string;
    language: string;
    menu: string;
    toggleTheme: string;
  };
}

const { locale, labels } = Astro.props;

const navItems = [
  { href: localizeHref("/#home", locale), label: labels.home },
  { href: localizeHref("/#experiences", locale), label: labels.experiences },
  { href: localizeHref("/#projects", locale), label: labels.projects },
  { href: localizeHref("/#contact", locale), label: labels.contact },
];
---

<header>
  <div class="header-menu">
    <a href={localizeHref("/#home", locale)} class="nav-item logo"> Juanma Ibarzabal </a>

    <div class="desktop-menu">
      <nav>
        {
          navItems.slice(1, navItems.length).map((item) => (
            <a href={item.href} class="nav-item">
              {item.label}
            </a>
          ))
        }
      </nav>
      <hr />
      <LanguageSwitcher locale={locale} label={labels.language} />
      <ToggleTheme label={labels.toggleTheme} />
      <DownloadCV label={labels.downloadCv} />
    </div>

    <Hamburger menuLabel={labels.menu} />
  </div>

  <Sidebar
    navItems={navItems}
    locale={locale}
    downloadCvLabel={labels.downloadCv}
    languageLabel={labels.language}
    toggleThemeLabel={labels.toggleTheme}
  />
</header>

<script>
  import { headerToggleOnScroll } from "./utils/scroll";
  import { initializeSidebar } from "./utils/sidebar";
  import { initializeNavigation } from "./utils/navigation";

  function setupHeader() {
    headerToggleOnScroll();
    initializeSidebar();
    initializeNavigation();
  }

  document.addEventListener("astro:page-load", setupHeader);
</script>
