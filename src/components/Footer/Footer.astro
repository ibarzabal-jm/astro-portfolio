---
import { Icon } from "astro-icon/components";
import "./Footer.css";

interface Props {
  madeWith: string;
  by: string;
  signatureAriaLabel: string;
}

const { madeWith, by, signatureAriaLabel } = Astro.props;
---

<footer>
  <div class="footer-content">
    <a
      href="https://github.com/ibarzabal-jm"
      target="_blank"
      rel="noopener noreferrer"
      class="made-with-love"
    >
      {madeWith} <Icon name="mdi:heart" /> {by} @ibarzabal-jm
    </a>
    <a
      href="https://www.linkedin.com/in/juan-manuel-ibarzabal/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={signatureAriaLabel}
      class="signature"
    >
      <Icon name="signature" />
    </a>
  </div>
</footer>
