---
import { Icon } from "astro-icon/components";
import type { Locale } from "@src/i18n/translations";
import { getI18n } from "@src/i18n/utils";
import "./HomeHero.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = getI18n(locale);

const startDate = new Date(2021, 3, 1);
const today = new Date();
let years = today.getFullYear() - startDate.getFullYear();
const hasNotReachedAnniversary =
  today.getMonth() < startDate.getMonth() ||
  (today.getMonth() === startDate.getMonth() && today.getDate() < startDate.getDate());
if (hasNotReachedAnniversary) years--;

const heroDescription = t.home.description.replace("{years}", String(years));
---

<div class="home-hero">
  <div class="hero-image">
    <img src="/juanma-foto.webp" alt="Juanma Ibarzabal" />
    <div class="image-background"></div>
  </div>
  <div class="hero-content">
    <h1>{t.home.greeting} <span class="wave">👋</span></h1>
    <p class="hero-description">{heroDescription}</p>
    <div class="location-availability">
      <p class="location">
        <Icon name="mdi:map-marker-outline" />
        {t.home.location}
      </p>
      <p class="availability">
        <span class="availability-dot-container">
          <span class="availability-dot"></span>
        </span>
        {t.home.availability}
      </p>
    </div>
    <div class="social-links">
      <a href="https://github.com/ibarzabal-jm" aria-label={t.accessibility.github} target="_blank" rel="noopener noreferrer">
        <Icon name="mdi:github" />
      </a>
      <a href="https://www.linkedin.com/in/juanma-ibarzabal/" aria-label={t.accessibility.linkedin} target="_blank" rel="noopener noreferrer">
        <Icon name="mdi:linkedin" />
      </a>
      <a href="mailto:ibarzabalsallesjm@gmail.com" aria-label={t.accessibility.email}>
        <Icon name="mdi:email" />
      </a>
    </div>
  </div>
</div>
