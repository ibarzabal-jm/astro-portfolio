---
import type { Locale } from "@src/i18n/translations";
import { getI18n, localizeHref } from "@src/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = getI18n(locale);
---

<a href={localizeHref("/#contact", locale)} class="contact-link"> {t.contact.contactLink} </a>

<style>
  .contact-link {
    text-decoration: none;
    color: #f75000;
    font-weight: bold;
    font-size: 1rem;
    transform: scale(1);
    transition: transform 0.3s ease-in-out;
  }

  .contact-link:hover {
    transform: scale(1.2);
  }
</style>
