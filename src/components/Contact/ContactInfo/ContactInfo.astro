---
import { Icon } from "astro-icon/components";
import ContactCard from "../ContactCard.astro";
import CopyToClipboard from "../../CopyToClipboard/CopyToClipboard.astro";
import type { Locale } from "@src/i18n/translations";
import { getI18n } from "@src/i18n/utils";
import "./ContactInfo.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = getI18n(locale);

const contactInfo = [
  {
    icon: "mdi:email",
    value: "ibarzabalsallesjm@gmail.com",
    href: "mailto:ibarzabalsallesjm@gmail.com",
  },
  {
    icon: "mdi:whatsapp",
    value: "+54 9 11 3785-4477",
    href: `https://wa.me/5491137854477?text=${encodeURIComponent(t.contact.whatsappText)}`,
  },
  {
    icon: "mdi:linkedin",
    value: "juan-manuel-ibarzabal",
    href: "https://www.linkedin.com/in/juan-manuel-ibarzabal/",
  },
];
---

<ContactCard title={t.contact.infoTitle}>
  <ul class="contact-list">
    {
      contactInfo.map((item) => (
        <li class="contact-item">
          <a href={item.href} target="_blank" rel="noopener noreferrer">
            <Icon name={item.icon} />
            {item.value}
          </a>
          <CopyToClipboard value={item.value} locale={locale} />
        </li>
      ))
    }
  </ul>
</ContactCard>
